# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Configuration (comma-separated origins or * for all)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Authentication & Authorization
# API_KEY: Server-to-server / Postman / personal client key (x-api-key header)
API_KEY="d14f4e7c-86e4-4fa9-8088-348df8527a42"

# Neon Auth (Managed Better Auth) - pulled via `neon env pull`
NEON_AUTH_BASE_URL="https://ep-sample.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-sample.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Neon PostgreSQL Database Credentials
# DATABASE_URL: Pooled connection string (-pooler) for application queries
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DATABASE_URL_UNPOOLED: Direct unpooled connection string for Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"
