{
  "name": "personal-api",
  "version": "1.0.0",
  "description": "Centralized reusable personal REST API backend",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run db:generate && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/swagger": "^1.3.1",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/functions": "^3.11.1",
    "elysia": "1.4.31",
    "jose": "^6.2.17",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "bun-types": "latest",
    "prisma": "7.10.1",
    "typescript": "^5.8.0 || ^7.0.0"
  },
  "module": "src/index.ts"
}
